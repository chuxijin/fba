{
  "name": "gongkao-reformatter-extension",
  "version": "1.0.10",
  "description": "公考真题/模考考场标准重排器浏览器插件",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.10.0",
  "scripts": {
    "deps:install": "pnpm install --ignore-workspace --frozen-lockfile --ignore-scripts",
    "dev": "vite build --watch --mode development",
    "build": "tsc && node build.js",
    "build:prod": "tsc && node build.js --api=https://api.yzxj.vip",
    "package:prod": "pnpm run build:prod && pwsh -NoProfile -File scripts/package.ps1",
    "test": "node --test tests/*.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "vue": "3.5.43"
  },
  "devDependencies": {
    "@types/chrome": "0.0.312",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "6.0.9",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-static-copy": "2.3.2"
  }
}
