{
  "manifest_version": 3,
  "name": "公考内容排版",
  "version": "1.0.0",
  "description": "一键将粉笔、华图等公考题库网页内容排版为国考 1:1 标准考场卷 (B5道林纸/仿宋/防断页/双面打印)，支持下载电脑与快速扫码打印",
  "permissions": [
    "storage",
    "downloads",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.fenbi.com/*",
    "*://*.fbstatic.cn/*",
    "*://*.huatu.com/*",
    "*://*.shikaobang.cn/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.fenbi.com/*",
        "*://*.huatu.com/*",
        "*://*.shikaobang.cn/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.fenbi.com/*",
        "*://*.huatu.com/*",
        "*://*.shikaobang.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "injected.js",
        "icons/*"
      ],
      "matches": [
        "*://*.fenbi.com/*",
        "*://*.huatu.com/*",
        "*://*.shikaobang.cn/*"
      ]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "公考内容排版",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}