# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = true
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 后台请求地址
VITE_SERVER_BASEURL = 'https://api.yzxj.vip'
VITE_SERVER_BASEURL_SECONDARY = 'https://api.yzxj.vip'
VITE_API_BASE_URL_RELEASE = 'https://api.yzxj.vip'
